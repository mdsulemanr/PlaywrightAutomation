{
  "name": "playwrightautomation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "regression": "npx playwright test",
    "e2eTests": "npx playwright test --grep @e2e",
    "apiTests": "npx playwright test --grep @api",
    "smokeTests": "npx playwright test --grep @smoke",
    "mobileTests": "npx playwright test --config=playwright.configMobilePorts.ts",
    "webkitTests": "npx playwright test --project=webkit",
    "chromeTests": "npx playwright test --project=chromium",
    "firefoxTests": "npx playwright test --project=firefox",
    "headedTests": "npx playwright test --headed",
    "debugTests": "npx playwright test --debug",
    "listTests": "npx playwright test --list",
    "traceTests": "npx playwright test --trace on",
    "report": "npx playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "exceljs": "^4.4.0"
  }
}
